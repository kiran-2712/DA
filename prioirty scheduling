#include <stdio.h>

int main() {
    int n, i, j, temp;
    int bt[10], pr[10], wt[10], tat[10], p[10];
    float total_wt = 0, total_tat = 0;

    printf("Number of Processes: ");
    scanf("%d", &n);

    // Input
    for (i = 0; i < n; i++) {
        printf("Enter BT and Priority for P%d: ", i+1);
        scanf("%d %d", &bt[i], &pr[i]);
        p[i] = i + 1;              // store process number
    }

    // Sort by Priority (lower number = higher priority)
    for (i = 0; i < n-1; i++) {
        for (j = 0; j < n-1-i; j++) {
            if (pr[j] > pr[j+1]) {
                temp = pr[j]; pr[j] = pr[j+1]; pr[j+1] = temp;
                temp = bt[j]; bt[j] = bt[j+1]; bt[j+1] = temp;
                temp = p[j];  p[j]  = p[j+1];  p[j+1]  = temp;
            }
        }
    }

    // Calculate WT and TAT
    wt[0] = 0;
    for (i = 1; i < n; i++)
        wt[i] = wt[i-1] + bt[i-1];

    for (i = 0; i < n; i++) {
        tat[i]    = wt[i] + bt[i];
        total_wt  += wt[i];
        total_tat += tat[i];
    }

    // Output
    printf("\nProcess\tBT\tPR\tWT\tTAT\n");
    printf("------------------------------------\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\n", p[i], bt[i], pr[i], wt[i], tat[i]);
    printf("------------------------------------\n");

    printf("Average WT  = %.2f\n", total_wt / n);
    printf("Average TAT = %.2f\n", total_tat / n);

    return 0;
}
