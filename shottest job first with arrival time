#include <stdio.h>
#include <limits.h>

int main() {

    int n, i, smallest, time, finish_time;
    int at[10], bt[10], remaining_bt[10], wt[10], tat[10], completed = 0;
    float total_wt = 0, total_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter arrival times and burst times:\n");
    for (i = 0; i < n; i++) {
        printf("Process %d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
        remaining_bt[i] = bt[i];
    }

    int shortest_bt;
    for (time = 0; completed != n; time++) {
        smallest = -1;
        shortest_bt = INT_MAX;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && remaining_bt[i] < shortest_bt && remaining_bt[i] > 0) {
                shortest_bt = remaining_bt[i];
                smallest = i;
            }
        }

        if (smallest == -1) {
            continue;
        }

        remaining_bt[smallest]--;

        if (remaining_bt[smallest] == 0) {
            completed++;
            finish_time = time + 1;
            tat[smallest] = finish_time - at[smallest];
            wt[smallest] = tat[smallest] - bt[smallest];

            total_wt += wt[smallest];
            total_tat += tat[smallest];
        }
    }

    printf("\nProcess   Arrival Time\tBurst Time\tWaiting Time\tTurnaround Time\n");
    printf("------------------------------------------------------------------------\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t\t%d\t\t%d\t\t%d\t\t%d\n", i + 1, at[i], bt[i], wt[i], tat[i]);
    }
    printf("------------------------------------------------------------------------\n");

    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    printf("Average Turnaround Time: %.2f\n", total_tat / n);

    return 0;
}





