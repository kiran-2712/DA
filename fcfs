#include <stdio.h>

int main() {
    int i, num, bt[20], wt[20], tat[20];
    float sum = 0, total = 0;

    printf("Number of Processes: ");
    scanf("%d", &num);

    printf("Enter CPU Burst Times: ");
    for(i = 0; i < num; i++){
        scanf("%d", &bt[i]);
    }

    wt[0] = 0;

    for(i = 1; i < num; i++){
        wt[i] = wt[i-1] + bt[i-1];
    }

    for(i = 0; i < num; i++){
        tat[i] = wt[i] + bt[i];
        sum += wt[i];
        total += tat[i];
    }

    printf("\nProcess\tBT\tWT\tTAT\n");
    printf("--------------------------------\n");

    for(i = 0; i < num; i++) {
        printf("P%d\t%d\t%d\t%d\n", i+1, bt[i], wt[i], tat[i]);
    }

    printf("--------------------------------\n\n");
    printf("Avg. Waiting Time = %.2f\n", sum/num);
    printf("Avg. Turnaround Time = %.2f\n", total/num);

    return 0;
}
