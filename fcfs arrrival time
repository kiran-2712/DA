#include <stdio.h>

int main() {
    int n, i, j, temp;
    int at[20], bt[20], wt[20], tat[20], p[20];
    int time = 0;
    float avg_wt = 0, avg_tat = 0;

    printf("No. of Processes: ");
    scanf("%d", &n);

    // Input
    for (i = 0; i < n; i++) {
        printf("Enter AT and BT for P%d: ", i+1);
        scanf("%d %d", &at[i], &bt[i]);
        p[i] = i + 1;
    }

    // Sort by Arrival Time (Bubble Sort)
    for (i = 0; i < n-1; i++) {
        for (j = i+1; j < n; j++) {
            if (at[i] > at[j]) {
                temp = at[i]; at[i] = at[j]; at[j] = temp;
                temp = bt[i]; bt[i] = bt[j]; bt[j] = temp;
                temp = p[i];  p[i]  = p[j];  p[j]  = temp;
            }
        }
    }

    // FCFS Calculation
    for (i = 0; i < n; i++) {
        if (time < at[i])
            time = at[i];    

        wt[i]  = time - at[i];    
        tat[i] = wt[i] + bt[i];   
        time  += bt[i];            

        avg_wt  += wt[i];
        avg_tat += tat[i];
    }

    // Output
    printf("\nP\tAT\tBT\tWT\tTAT\n");
    printf("-------------------------------------\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\n", p[i], at[i], bt[i], wt[i], tat[i]);

    printf("\nAvg WT  = %.2f\n", avg_wt  / n);
    printf("Avg TAT = %.2f\n", avg_tat / n);

    return 0;
}





